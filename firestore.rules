rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Education items (Publicly readable)
    match /educationItems/{educationId} {
      allow read: if true;
      allow write: if true; // Allow seeding for portfolio applet
    }

    // User progress (Owner only)
    match /userProgress/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
